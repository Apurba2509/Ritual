# ── Firebase (Project settings → General → Your apps → Web app config) ──
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── AI (Firebase AI Logic → Gemini Developer API). Optional overrides ──
# EXPO_PUBLIC_GEMINI_MODEL_FAST=gemini-3.5-flash-lite   # quick log (~1.5 s)
# EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash             # coach & weekly review (~3 s)
# EXPO_PUBLIC_AI_DISABLED=true

# ── Cloudinary (photo check-ins & avatars, unsigned upload preset) ──
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
