{
  "expo": {
    "name": "Ritual",
    "slug": "Ritual",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ritual",
    "userInterfaceStyle": "automatic",
    "description": "Habits that track themselves: phone sensing (steps, walks, runs, screen time) that works offline with the app closed, an on-device behaviour coach that adapts your goals, a mindful pause before distracting apps, AI logging, streaks, XP and friends.",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.genzboy.Ritual",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.genzboy.Ritual",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_HEALTH",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Ritual — the habit tracker that tracks itself",
      "shortName": "Ritual",
      "themeColor": "#0B0B0C",
      "backgroundColor": "#0B0B0C"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0B0B0C",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D4FF3F"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "react-native-health-connect",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ritual lets you attach photos to check-ins.",
          "cameraPermission": "Ritual lets you snap a photo as proof of a check-in."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-background-task",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ritual uses the microphone so you can log habits by saying what you did.",
          "speechRecognitionPermission": "Ritual turns what you say into habit check-ins.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.tts"]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": ["./assets/fonts/InterTight_700Bold.ttf", "./assets/fonts/InterTight_500Medium.ttf"],
          "widgets": [
            {
              "name": "Today",
              "label": "Ritual · Today",
              "description": "Your day ring and next habits. Tap a habit to complete it.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview/today.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dab67e0e-3204-4330-9d21-8f60646f8131"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dab67e0e-3204-4330-9d21-8f60646f8131"
      }
    }
  }
}
