# Copy to .env.local to run the app against the local Firebase Emulator Suite (npm run emulators).
# .env.local overrides .env — delete it to go back to your real Firebase project.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-ritual.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-ritual
EXPO_PUBLIC_FIREBASE_APP_ID=demo-app
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
EXPO_PUBLIC_AI_DISABLED=true
